{
  "name": "js-runner-kit",
  "displayName": "JS Runner Kit",
  "description": "Run multiple JS scripts in parallel terminals + npm scripts sidebar",
  "version": "1.1.0",
  "publisher": "jinkeli",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.85.0",
    "cursor": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/li1125435097/js-runner.git"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onView:npmScriptsView",
    "onView:runningScriptsView",
    "onView:languageInterpretersView",
    "workspaceContains:package.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jsRunner.runCurrentFile",
        "title": "Run JS File",
        "icon": "$(play)"
      },
      {
        "command": "jsRunner.runCurrentFileNewTerminal",
        "title": "Run JS File in New Terminal",
        "icon": "$(debug-start)"
      },
      {
        "command": "jsRunner.stopAll",
        "title": "Stop All Running Scripts",
        "icon": "$(debug-stop)"
      },
      {
        "command": "jsRunner.stopTerminal",
        "title": "Stop Running Script",
        "icon": "$(close)"
      },
      {
        "command": "jsRunner.refreshScripts",
        "title": "Refresh NPM Scripts",
        "icon": "$(refresh)"
      },
      {
        "command": "jsRunner.filterNpmScripts",
        "title": "Search Package Path",
        "icon": "$(search)"
      },
      {
        "command": "jsRunner.clearNpmScriptsFilter",
        "title": "Clear Search",
        "icon": "$(close)"
      },
      {
        "command": "jsRunner.pinNpmScript",
        "title": "Pin",
        "icon": "$(pin)"
      },
      {
        "command": "jsRunner.unpinNpmScript",
        "title": "Unpin",
        "icon": "$(pinned)"
      },
      {
        "command": "jsRunner.pinNpmPackage",
        "title": "Pin",
        "icon": "$(pin)"
      },
      {
        "command": "jsRunner.unpinNpmPackage",
        "title": "Unpin",
        "icon": "$(pinned)"
      },
      {
        "command": "jsRunner.runNpmScript",
        "title": "Run NPM Script",
        "icon": "$(play)"
      },
      {
        "command": "jsRunner.debugNpmScript",
        "title": "Debug NPM Script",
        "icon": "$(debug-alt)"
      },
      {
        "command": "jsRunner.setNpmScriptShortcut",
        "title": "Set Script Shortcut",
        "icon": "$(keyboard)"
      },
      {
        "command": "jsRunner.runNpmScriptByShortcut",
        "title": "Run NPM Script (Shortcut)"
      },
      {
        "command": "jsRunner.focusRunningTerminal",
        "title": "Focus Running Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "jsRunner.viewInstalledPackages",
        "title": "View Installed Packages",
        "icon": "$(list-unordered)"
      },
      {
        "command": "jsRunner.selectPackageManager",
        "title": "Select Package Manager",
        "icon": "$(edit)"
      },
      {
        "command": "jsRunner.selectRegistry",
        "title": "Select Registry",
        "icon": "$(edit)"
      },
      {
        "command": "jsRunner.installDependencies",
        "title": "Install Dependencies",
        "icon": "$(cloud-download)"
      },
      {
        "command": "jsRunner.addInterpreter",
        "title": "Add Language Interpreter",
        "icon": "$(add)"
      },
      {
        "command": "jsRunner.editInterpreter",
        "title": "Edit Language Interpreter",
        "icon": "$(edit)"
      },
      {
        "command": "jsRunner.removeInterpreter",
        "title": "Remove Language Interpreter",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jsRunner",
          "title": "JS Runner",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "jsRunner": [
        {
          "id": "npmScriptsView",
          "name": "NPM Scripts"
        },
        {
          "id": "runningScriptsView",
          "name": "Running Scripts"
        },
        {
          "id": "languageInterpretersView",
          "name": "Language Interpreters"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "jsRunner.runCurrentFile",
          "when": "jsRunner.active && jsRunner.canRunCurrentFile",
          "group": "navigation@1"
        },
        {
          "command": "jsRunner.runCurrentFileNewTerminal",
          "when": "jsRunner.active && jsRunner.canRunCurrentFile",
          "group": "navigation@2"
        }
      ],
      "editor/title/run": [
        {
          "command": "jsRunner.runCurrentFile",
          "when": "jsRunner.active && jsRunner.canRunCurrentFile",
          "group": "run@1"
        },
        {
          "command": "jsRunner.runCurrentFileNewTerminal",
          "when": "jsRunner.active && jsRunner.canRunCurrentFile",
          "group": "run@2"
        }
      ],
      "view/title": [
        {
          "command": "jsRunner.filterNpmScripts",
          "when": "view == npmScriptsView && jsRunner.active",
          "group": "navigation@1"
        },
        {
          "command": "jsRunner.clearNpmScriptsFilter",
          "when": "view == npmScriptsView && jsRunner.active && jsRunner.npmScriptsFiltered",
          "group": "navigation@2"
        },
        {
          "command": "jsRunner.refreshScripts",
          "when": "view == npmScriptsView && jsRunner.active",
          "group": "navigation@3"
        },
        {
          "command": "jsRunner.addInterpreter",
          "when": "view == languageInterpretersView && jsRunner.active",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "jsRunner.runNpmScript",
          "when": "view == npmScriptsView && (viewItem == npmScript || viewItem == npmScriptJs || viewItem == npmScriptPinned || viewItem == npmScriptJsPinned)",
          "group": "inline@1"
        },
        {
          "command": "jsRunner.debugNpmScript",
          "when": "view == npmScriptsView && (viewItem == npmScriptJs || viewItem == npmScriptJsPinned)",
          "group": "inline@2"
        },
        {
          "command": "jsRunner.setNpmScriptShortcut",
          "when": "view == npmScriptsView && (viewItem == npmScript || viewItem == npmScriptJs || viewItem == npmScriptPinned || viewItem == npmScriptJsPinned)",
          "group": "inline@3"
        },
        {
          "command": "jsRunner.pinNpmScript",
          "when": "view == npmScriptsView && (viewItem == npmScript || viewItem == npmScriptJs)",
          "group": "inline@4"
        },
        {
          "command": "jsRunner.unpinNpmScript",
          "when": "view == npmScriptsView && (viewItem == npmScriptPinned || viewItem == npmScriptJsPinned)",
          "group": "inline@4"
        },
        {
          "command": "jsRunner.pinNpmPackage",
          "when": "view == npmScriptsView && viewItem == packageGroup",
          "group": "inline@1"
        },
        {
          "command": "jsRunner.unpinNpmPackage",
          "when": "view == npmScriptsView && viewItem == packageGroupPinned",
          "group": "inline@1"
        },
        {
          "command": "jsRunner.selectPackageManager",
          "when": "view == npmScriptsView && viewItem == packageManagerSetting",
          "group": "inline@1"
        },
        {
          "command": "jsRunner.selectRegistry",
          "when": "view == npmScriptsView && viewItem == registrySetting",
          "group": "inline@1"
        },
        {
          "command": "jsRunner.installDependencies",
          "when": "view == npmScriptsView && viewItem == packageManagerInstall",
          "group": "inline@1"
        },
        {
          "command": "jsRunner.viewInstalledPackages",
          "when": "view == npmScriptsView && viewItem == packageManagerViewPackages",
          "group": "inline@1"
        },
        {
          "command": "jsRunner.stopTerminal",
          "when": "view == runningScriptsView && viewItem == runningScript",
          "group": "inline"
        },
        {
          "command": "jsRunner.editInterpreter",
          "when": "view == languageInterpretersView && viewItem == languageInterpreter",
          "group": "inline@1"
        },
        {
          "command": "jsRunner.removeInterpreter",
          "when": "view == languageInterpretersView && viewItem == languageInterpreter",
          "group": "inline@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "jsRunner.runCurrentFile",
        "key": "f4",
        "when": "editorTextFocus && jsRunner.canRunCurrentFile"
      },
      {
        "command": "jsRunner.runCurrentFileNewTerminal",
        "key": "ctrl+f4",
        "when": "editorTextFocus && jsRunner.canRunCurrentFile"
      },
      {
        "command": "jsRunner.runNpmScriptByShortcut",
        "key": "f1",
        "args": {
          "keyId": "f1"
        },
        "when": "jsRunner.shortcut.f1"
      },
      {
        "command": "jsRunner.runNpmScriptByShortcut",
        "key": "f2",
        "args": {
          "keyId": "f2"
        },
        "when": "jsRunner.shortcut.f2"
      },
      {
