{
  "name": "js-runner-kit",
  "displayName": "JS Runner Kit",
  "description": "Run multiple JS scripts in parallel terminals + npm scripts sidebar",
  "version": "0.0.4",
  "publisher": "jinkeli",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.85.0",
    "cursor": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/li1125435097/js-runner.git"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onView:npmScriptsView",
    "onView:runningScriptsView",
    "onView:languageInterpretersView",
    "workspaceContains:package.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jsRunner.runCurrentFile",
        "title": "Run JS File",
        "icon": "$(play)"
      },
      {
        "command": "jsRunner.runCurrentFileNewTerminal",
        "title": "Run JS File in New Terminal",
        "icon": "$(debug-start)"
      },
      {
        "command": "jsRunner.stopAll",
        "title": "Stop All Running Scripts",
        "icon": "$(debug-stop)"
      },
      {
        "command": "jsRunner.stopTerminal",
        "title": "Stop Running Script",
        "icon": "$(close)"
      },
      {
        "command": "jsRunner.refreshScripts",
        "title": "Refresh NPM Scripts",
        "icon": "$(refresh)"
      },
      {
        "command": "jsRunner.runNpmScript",
        "title": "Run NPM Script",
        "icon": "$(play)"
      },
      {
        "command": "jsRunner.debugNpmScript",
        "title": "Debug NPM Script",
        "icon": "$(debug-alt)"
      },
      {
        "command": "jsRunner.focusRunningTerminal",
        "title": "Focus Running Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "jsRunner.addInterpreter",
        "title": "Add Language Interpreter",
        "icon": "$(add)"
      },
      {
        "command": "jsRunner.editInterpreter",
        "title": "Edit Language Interpreter",
        "icon": "$(edit)"
      },
      {
        "command": "jsRunner.removeInterpreter",
        "title": "Remove Language Interpreter",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jsRunner",
          "title": "JS Runner",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "jsRunner": [
        {
          "id": "npmScriptsView",
          "name": "NPM Scripts"
        },
        {
          "id": "runningScriptsView",
          "name": "Running Scripts"
        },
        {
          "id": "languageInterpretersView",
          "name": "Language Interpreters"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "jsRunner.runCurrentFile",
          "when": "jsRunner.active && jsRunner.canRunCurrentFile",
          "group": "navigation@1"
        },
        {
          "command": "jsRunner.runCurrentFileNewTerminal",
          "when": "jsRunner.active && jsRunner.canRunCurrentFile",
          "group": "navigation@2"
        }
      ],
      "editor/title/run": [
        {
          "command": "jsRunner.runCurrentFile",
          "when": "jsRunner.active && jsRunner.canRunCurrentFile",
          "group": "run@1"
        },
        {
          "command": "jsRunner.runCurrentFileNewTerminal",
          "when": "jsRunner.active && jsRunner.canRunCurrentFile",
          "group": "run@2"
        }
      ],
      "view/title": [
        {
          "command": "jsRunner.refreshScripts",
          "when": "view == npmScriptsView && jsRunner.active",
          "group": "navigation"
        },
        {
          "command": "jsRunner.addInterpreter",
          "when": "view == languageInterpretersView && jsRunner.active",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "jsRunner.runNpmScript",
          "when": "view == npmScriptsView && (viewItem == npmScript || viewItem == npmScriptJs)",
          "group": "inline@1"
        },
        {
          "command": "jsRunner.debugNpmScript",
          "when": "view == npmScriptsView && viewItem == npmScriptJs",
          "group": "inline@2"
        },
        {
          "command": "jsRunner.stopTerminal",
          "when": "view == runningScriptsView && viewItem == runningScript",
          "group": "inline"
        },
        {
          "command": "jsRunner.editInterpreter",
          "when": "view == languageInterpretersView && viewItem == languageInterpreter",
          "group": "inline@1"
        },
        {
          "command": "jsRunner.removeInterpreter",
          "when": "view == languageInterpretersView && viewItem == languageInterpreter",
          "group": "inline@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "jsRunner.runCurrentFile",
        "key": "f4",
        "when": "editorTextFocus && jsRunner.canRunCurrentFile"
      },
      {
        "command": "jsRunner.runCurrentFileNewTerminal",
        "key": "ctrl+f4",
        "when": "editorTextFocus && jsRunner.canRunCurrentFile"
      }
    ],
    "configuration": {
      "title": "JS Runner",
      "properties": {
        "jsRunner.interpreters": {
          "type": "array",
          "default": [
            {
              "languageId": "shellscript",
              "label": "Bash",
              "path": "bash"
            },
            {
              "languageId": "java",
              "label": "Java",
              "path": "java"
            },
            {
              "languageId": "javascript",
              "label": "JavaScript",
              "path": "node"
            },
            {
              "languageId": "javascriptreact",
              "label": "JavaScript React",
              "path": "node"
            },
            {
              "languageId": "python",
              "label": "Python",
              "path": "python"
            },
            {
              "languageId": "typescript",
              "label": "TypeScript",
              "path": "node --experimental-strip-types"
            },
            {
              "languageId": "html",
              "label": "HTML",
              "path": "default browser"
            }
          ],
          "description": "Language interpreters used when running files from the editor.",
          "items": {
            "type": "object",
            "required": [
              "languageId",
              "path"
            ],
            "properties": {
              "languageId": {
                "type": "string",
                "description": "VS Code language ID"
              },
              "label": {
                "type": "string",
                "description": "Display name in the sidebar"
              },
              "path": {
                "type": "string",
                "description": "Interpreter executable path or command"
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "compile:test": "npm run compile && tsc -p test/tsconfig.json",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "install:plugin": "cursor --install-extension js-runner-kit-0.0.4.vsix",
    "test:unit": "npm run compile:test && node dist/test/runUnitTests.js",
    "test:integration": "npm run compile:test && node dist/test/runIntegrationTests.js",
    "test": "npm run test:unit && npm run test:integration",
    "publish": "vsce publish",
    "publish:patch": "vsce publish patch",
    "publish:minor": "vsce publish minor",
    "publish:major": "vsce publish major"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/proxyquire": "^1.3.31",
    "@types/sinon": "^17.0.4",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "ovsx": "^1.1.1",
    "proxyquire": "^2.1.3",
    "sinon": "^19.0.2",
    "typescript": "^5.3.3"
  }
}
