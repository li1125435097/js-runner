    "colors": [
      {
        "id": "jsRunner.pinnedForeground",
        "description": "Foreground color for pinned packages and scripts in the NPM Scripts view.",
        "defaults": {
          "dark": "#46ee37",
          "light": "#46ee37",
          "highContrast": "#46ee37"
        }
      }
    ],
    "configuration": {
      "title": "JS Runner",
      "properties": {
        "jsRunner.pinnedForeground": {
          "type": "string",
          "default": "#46ee37",
          "format": "color",
          "description": "Foreground color for pinned packages and scripts in the NPM Scripts view. Change this in user settings."
        },
        "jsRunner.packageManager": {
          "type": "string",
          "enum": [
            "auto",
            "npm",
            "yarn",
            "pnpm",
            "bun"
          ],
          "default": "auto",
          "description": "Default package manager when sidebar setting is auto."
        },
        "jsRunner.packageManagerSettings": {
          "type": "object",
          "default": {},
          "description": "Per-package package manager and registry overrides. Keys are relative paths to package directories (\".\" for workspace root). Saved in the workspace .vscode/settings.json file.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "manager": {
                "type": "string",
                "description": "Package manager: auto, npm, yarn, pnpm, bun, or custom CLI name"
              },
              "registry": {
                "type": "string",
                "description": "Registry preset id, auto, or custom URL"
              }
            }
          }
        },
        "jsRunner.interpreters": {
          "type": "array",
          "default": [
            {
              "languageId": "shellscript",
              "label": "Bash",
              "path": "bash"
            },
            {
              "languageId": "java",
              "label": "Java",
              "path": "java"
            },
            {
              "languageId": "javascript",
              "label": "JavaScript",
              "path": "node"
            },
            {
              "languageId": "javascriptreact",
              "label": "JavaScript React",
              "path": "node"
            },
            {
              "languageId": "python",
              "label": "Python",
              "path": "python"
            },
            {
              "languageId": "typescript",
              "label": "TypeScript",
              "path": "node --experimental-strip-types"
            },
            {
              "languageId": "html",
              "label": "HTML",
              "path": "default browser"
            }
          ],
          "description": "Language interpreters used when running files from the editor.",
          "items": {
            "type": "object",
            "required": [
              "languageId",
              "path"
            ],
            "properties": {
              "languageId": {
                "type": "string",
                "description": "VS Code language ID"
              },
              "label": {
                "type": "string",
                "description": "Display name in the sidebar"
              },
              "path": {
                "type": "string",
                "description": "Interpreter executable path or command"
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "compile:test": "npm run compile && tsc -p test/tsconfig.json",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package -o release",
    "install:plugin": "node -e \"const p=require('./package.json');const v=p.version;const n=p.name;const f=`release/${n}-${v}.vsix`;const {execSync}=require('child_process');console.log('Installing:',f);execSync(`cursor --install-extension \\\"${f}\\\"`,{stdio:'inherit'});\"",
    "test:unit": "npm run compile:test && node dist/test/runUnitTests.js",
    "test:integration": "npm run compile:test && node dist/test/runIntegrationTests.js",
    "test": "npm run test:unit && npm run test:integration",
    "publish": "vsce publish",
    "patch": "npm version patch",
    "minor": "npm version minor",
    "major": "npm version major"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/proxyquire": "^1.3.31",
    "@types/sinon": "^17.0.4",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "ovsx": "^1.1.1",
    "proxyquire": "^2.1.3",
    "sinon": "^19.0.2",
    "typescript": "^5.3.3"
  }
}
